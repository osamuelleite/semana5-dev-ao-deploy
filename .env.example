# Copie este arquivo para .env e ajuste os valores para o seu ambiente local.
# .env nunca deve ser versionado (contem credenciais).

# --- PostgreSQL ---
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DEBUG=True
DJANGO_SECRET_KEY=dev-only-secret-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Next.js ---
# URL interna (rede do compose) que o frontend usa para buscar dados do backend.
BACKEND_INTERNAL_URL=http://backend:8000
